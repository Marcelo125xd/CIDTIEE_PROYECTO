# Servidor
PORT=3001
HOST=0.0.0.0

# Orígenes permitidos para el frontend en desarrollo (separados por coma)
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Proveedor de contenido: local-json | notion
CONTENT_PROVIDER=local-json

# Ruta al JSON curado, relativa a la raíz del repositorio
CONTENT_PATH=data/curated/content.json

# API de Notion (solo si CONTENT_PROVIDER=notion)
# Crear una integración en https://www.notion.so/my-integrations y compartir
# cada base de datos con esa integración. El token no debe commitearse.
NOTION_TOKEN=
NOTION_VERSION=2026-03-11

# Mapa de data sources de Notion. Ejemplo:
# NOTION_DATA_SOURCES={"projects":"xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx","publications":"...","seminars":"...","becas":"...","people":"...","news":"...","resources":"..."}
NOTION_DATA_SOURCES={}

# Tiempo de caché del contenido de Notion, en segundos
NOTION_CACHE_TTL=300
